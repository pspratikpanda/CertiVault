# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Replace with your local or managed MongoDB connection string. Never commit a real URI.
MONGO_URI=mongodb://127.0.0.1:27017/certivault

# Authentication Configuration
# Use a long random value locally; never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Browser origins permitted to call this API (supports comma-separated URLs for multi-origin/dev/production setups).
FRONTEND_URL=http://localhost:5173

# Database key encryption at rest configuration
# Must be a 32-character base64 or string key for AES-256-GCM.
DB_ENCRYPTION_KEY=replace-with-a-32-character-encryption-key-here
