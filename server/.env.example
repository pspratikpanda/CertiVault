# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Replace with your local or managed MongoDB connection string. Never commit a real URI.
MONGO_URI=mongodb://127.0.0.1:27017/certivault

# Authentication Configuration
# Use a long random value locally; never commit a real secret.
JWT_SECRET=replace-with-a-long-random-secret

# Browser origin permitted to call this API.
FRONTEND_URL=http://localhost:5173
